---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import { content, SITE } from "../content";
import heroImage from "../assets/hero-enter.png";
import avenHome from "../assets/projects/aven-home.png";
import avenSession from "../assets/projects/aven-session.png";
import avenNutrition from "../assets/projects/aven-nutrition.png";
import avenDone from "../assets/projects/aven-done.png";
import butShot from "../assets/projects/but.png";

const c = content.fr;

// Outils disposés « en vrac » de part et d'autre de la timeline du workflow.
// Positions en % du conteneur (gauche), taille en px, rotation en degrés.
const toolLogos = [
  { domain: "openai.com", left: 5, top: 5, size: 46, rot: -8, delay: 0 },
  { domain: "figma.com", left: 11, top: 15, size: 34, rot: 7, delay: 0.12 },
  { domain: "github.com", left: 3, top: 26, size: 42, rot: -5, delay: 0.06 },
  { domain: "cloudflare.com", left: 10, top: 38, size: 38, rot: 9, delay: 0.2 },
  { domain: "astro.build", left: 4, top: 50, size: 40, rot: -6, delay: 0.1 },
  { domain: "kotlinlang.org", left: 11, top: 62, size: 32, rot: 5, delay: 0.16 },
  { domain: "swift.org", left: 4, top: 74, size: 36, rot: -10, delay: 0.04 },
  { domain: "java.com", left: 10, top: 86, size: 32, rot: 8, delay: 0.22 },
  { domain: "anthropic.com", left: 90, top: 5, size: 42, rot: 8, delay: 0.08 },
  { domain: "opencode.ai", left: 88, top: 14, size: 34, rot: -7, delay: 0.18 },
  { domain: "vercel.com", left: 93, top: 23, size: 38, rot: 6, delay: 0.02 },
  { domain: "supabase.com", left: 88, top: 32, size: 36, rot: -9, delay: 0.14 },
  { domain: "react.dev", left: 92, top: 41, size: 38, rot: 7, delay: 0.24 },
  { domain: "typescriptlang.org", left: 88, top: 50, size: 32, rot: -5, delay: 0.1 },
  { domain: "nodejs.org", left: 93, top: 59, size: 36, rot: 9, delay: 0.2 },
  { domain: "git-scm.com", left: 88, top: 68, size: 34, rot: -8, delay: 0.06 },
  { domain: "vitejs.dev", left: 92, top: 77, size: 34, rot: 5, delay: 0.16 },
  { domain: "tailwindcss.com", left: 89, top: 86, size: 32, rot: -6, delay: 0.12 },
];

// Icônes des compétences (clé = libellé FR, pour rester indépendant de la langue).
// URLs complètes : logo.dev pour la plupart, simple-icons pour le langage C.
const logoDev = (domain: string) =>
  `https://img.logo.dev/${domain}?token=${SITE.logoDevToken}&size=64&format=png`;

const skillIcons: Record<string, string> = {
  Java: logoDev("java.com"),
  Kotlin: logoDev("kotlinlang.org"),
  C: "/logos/c.svg",
  Swift: logoDev("swift.org"),
  JavaScript: "/logos/javascript.svg",
  PHP: logoDev("php.net"),
  "HTML / CSS": logoDev("w3.org"),
  React: logoDev("react.dev"),
  Git: logoDev("git-scm.com"),
  GitHub: logoDev("github.com"),
  "Linux (shell)": logoDev("linux.org"),
  Cloudflare: logoDev("cloudflare.com"),
  Vercel: logoDev("vercel.com"),
  Supabase: logoDev("supabase.com"),
  Codex: logoDev("openai.com"),
  "Claude Code": logoDev("anthropic.com"),
  OpenCode: logoDev("opencode.ai"),
  MCP: logoDev("modelcontextprotocol.io"),
  Hermès: logoDev("nousresearch.com"),
};

// Captures par projet (index de c.projects.items).
const projectImages: Record<number, { src: ImageMetadata; alt: string }[]> = {
  1: [{ src: butShot, alt: "Site du BUT Informatique — page d'accueil" }],
  2: [
    { src: avenHome, alt: "Aven — écran d'accueil" },
    { src: avenSession, alt: "Aven — séance en cours" },
    { src: avenNutrition, alt: "Aven — suivi nutritionnel" },
    { src: avenDone, alt: "Aven — séance terminée" },
  ],
};

// Dépôt GitHub par projet (index), sinon on renvoie vers le profil.
const projectRepos: Record<number, string> = {
  2: "https://github.com/EvroAI/aven-app",
  4: "https://github.com/EvroAI/tom-testu-candidature",
};
---

<Layout>
  <!-- ===================== Héros ===================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <Image
        src={heroImage}
        alt=""
        class="hero-img"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="hero-veil" aria-hidden="true"></span>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <p class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          <span data-i18n="hero.eyebrow">{c.hero.eyebrow}</span>
        </p>
        <p class="hero-hello" data-i18n="hero.hello">{c.hero.hello}</p>
        <h1 class="hero-name" id="hero-title">Tom Testu</h1>
        <p class="hero-role" data-i18n="hero.role">{c.hero.role}</p>
        <p class="hero-lead" data-i18n="hero.lead">{c.hero.lead}</p>

        <div class="hero-cta">
          <a class="btn btn-primary" href="#workflow">
            <span data-i18n="hero.ctaPrimary">{c.hero.ctaPrimary}</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="btn btn-ghost" href="#contact">
            <span data-i18n="hero.ctaSecondary">{c.hero.ctaSecondary}</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================== Infos clés ===================== -->
  <section class="hero-info">
    <div class="container hero-info-grid">
      <dl class="hero-facts reveal">
        {
          c.hero.facts.map((fact, i) => (
            <div class="hero-fact">
              <dt class="fact-label" data-i18n={`hero.facts.${i}.label`}>
                {fact.label}
              </dt>
              <dd class="fact-value" data-i18n={`hero.facts.${i}.value`}>
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="hero-visual reveal" data-delay="2">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span class="terminal-title" data-i18n="hero.terminal.title"
              >{c.hero.terminal.title}</span
            >
          </div>
          <div class="terminal-body" aria-live="polite">
            {
              c.hero.terminal.lines.map((line, i) => (
                <div class="terminal-line">
                  <span class="prompt" aria-hidden="true">$</span>{" "}
                  <span class="cmd" data-i18n={`hero.terminal.lines.${i}.cmd`}>
                    {line.cmd}
                  </span>
                  <span class="out" data-i18n={`hero.terminal.lines.${i}.out`}>
                    {line.out}
                  </span>
                </div>
              ))
            }
            <form class="terminal-line terminal-form" data-terminal-form>
              <span class="prompt" aria-hidden="true">$</span>
              <input
                class="terminal-input"
                type="text"
                name="command"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                data-terminal-input
                aria-label={c.hero.terminal.inputLabel}
                data-i18n-attr="aria-label:hero.terminal.inputLabel"
              />
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Profil ===================== -->
  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="about.kicker">{c.about.kicker}</p>
        <h2 class="section-title" id="about-title" data-i18n="about.title">
          {c.about.title}
        </h2>
      </div>

      <div class="about-grid">
        <div class="prose reveal">
          {
            c.about.paragraphs.map((paragraph, i) => (
              <p data-i18n={`about.paragraphs.${i}`}>{paragraph}</p>
            ))
          }
        </div>

        <div class="about-highlights reveal" data-delay="1">
          {
            c.about.highlights.map((highlight, i) => (
              <div class="highlight-card" data-drag>
                <div class="highlight-value" data-i18n={`about.highlights.${i}.value`}>
                  {highlight.value}
                </div>
                <div class="highlight-label" data-i18n={`about.highlights.${i}.label`}>
                  {highlight.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Compétences ===================== -->
  <section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="skills.kicker">{c.skills.kicker}</p>
        <h2 class="section-title" id="skills-title" data-i18n="skills.title">
          {c.skills.title}
        </h2>
        <p class="section-intro" data-i18n="skills.intro">{c.skills.intro}</p>
      </div>

      <div class="skill-index">
        {
          c.skills.groups.map((group, i) => (
            <div class="skill-row reveal" data-delay={String(i % 3)}>
              <div class="skill-cat">
                <span class="skill-cat-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="skill-cat-name" data-i18n={`skills.groups.${i}.title`}>
                  {group.title}
                </h3>
              </div>
              <ul class="skill-list">
                {group.items.map((item, j) => (
                  <li>
                    {skillIcons[item] && (
                      <span class="skill-ico" aria-hidden="true">
                        <span class="skill-ico-fallback">{item.charAt(0)}</span>
                        <img
                          src={skillIcons[item]}
                          alt=""
                          width="64"
                          height="64"
                          decoding="async"
                          referrerpolicy="no-referrer"
                        />
                      </span>
                    )}
                    <span data-i18n={`skills.groups.${i}.items.${j}`}>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="skill-learning reveal">
        <p class="skill-learning-title" data-i18n="skills.learningTitle">
          {c.skills.learningTitle}
        </p>
        <ul class="skill-learning-list">
          {
            c.skills.learning.map((item, i) => (
              <li>
                <span class="skill-learning-name" data-i18n={`skills.learning.${i}.name`}>
                  {item.name}
                </span>
                <span class="skill-learning-note" data-i18n={`skills.learning.${i}.note`}>
                  {item.note}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== Projets ===================== -->
  <section id="projects" class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="projects.kicker">{c.projects.kicker}</p>
        <h2 class="section-title" id="projects-title" data-i18n="projects.title">
          {c.projects.title}
        </h2>
        <p class="section-intro" data-i18n="projects.intro">{c.projects.intro}</p>
      </div>

      <div class="projects-grid">
        {
          c.projects.items.map((project, i) => (
            <article class="folder reveal" data-delay={String(i % 2)}>
              <div class="folder-band" aria-hidden="true">
                <span class="folder-paper folder-paper--a"></span>
                <span class="folder-paper folder-paper--b"></span>
              </div>

              <div class="folder-front">
                <svg
                  class="folder-front-shape"
                  viewBox="0 0 600 300"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path d="M0 300 L0 20 Q0 0 20 0 L200 0 A70 30 0 0 0 340 0 L580 0 Q600 0 600 20 L600 300 Z" />
                </svg>

                <div class="folder-front-content">
                  <h3 class="folder-title" data-i18n={`projects.items.${i}.title`}>
                    {project.title}
                  </h3>
                  <p class="folder-meta" data-i18n={`projects.items.${i}.meta`}>
                    {project.meta}
                  </p>
                  <p class="folder-desc" data-i18n={`projects.items.${i}.description`}>
                    {project.description}
                  </p>
                  <ul class="folder-tags">
                    {project.tags.map((tag, j) => (
                      <li data-i18n={`projects.items.${i}.tags.${j}`}>{tag}</li>
                    ))}
                  </ul>

                  <div class="folder-footer">
                    <svg
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 7a2 2 0 0 1 2-2h3.6l1.8 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                      ></path>
                    </svg>
                    <span class="folder-index" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                  </div>
                </div>
              </div>

              <button
                class="folder-hit"
                type="button"
                data-open-project={i}
                aria-haspopup="dialog"
                aria-controls={`project-${i}`}
              >
                <span class="visually-hidden" data-i18n={`projects.items.${i}.title`}>
                  {project.title}
                </span>
                <span class="visually-hidden" data-i18n="projects.openLabel">
                  {c.projects.openLabel}
                </span>
              </button>
            </article>
          ))
        }
      </div>

      {
        c.projects.items.map((project, i) => (
          <dialog class="project-dialog" id={`project-${i}`} data-project-dialog={i}>
            <button class="project-dialog-close" type="button" data-close-project>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
              <span class="visually-hidden" data-i18n="projects.closeLabel">
                {c.projects.closeLabel}
              </span>
            </button>

            <div class="project-dialog-inner">
              <p class="project-dialog-meta" data-i18n={`projects.items.${i}.meta`}>
                {project.meta}
              </p>
              <h3 class="project-dialog-title" data-i18n={`projects.items.${i}.title`}>
                {project.title}
              </h3>
              <p class="project-dialog-desc" data-i18n={`projects.items.${i}.description`}>
                {project.description}
              </p>
              <ul class="project-dialog-tags">
                {project.tags.map((tag, j) => (
                  <li data-i18n={`projects.items.${i}.tags.${j}`}>{tag}</li>
                ))}
              </ul>

              <div class="project-dialog-actions">
                <a
                  class="project-dialog-repo"
                  href={projectRepos[i] ?? SITE.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
                    ></path>
                  </svg>
                  {projectRepos[i] ? (
                    <span data-i18n="projects.repoCta">{c.projects.repoCta}</span>
                  ) : (
                    <span data-i18n="projects.profileCta">{c.projects.profileCta}</span>
                  )}
                </a>
              </div>

              {projectImages[i] && (
                <div class="project-dialog-gallery">
                  {projectImages[i].map((shot) => (
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[360, 540, 760]}
                      sizes="(max-width: 700px) 70vw, 340px"
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
              )}
            </div>
          </dialog>
        ))
      }

      <div class="projects-actions reveal">
        <a
          class="btn btn-ghost"
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
            ></path>
          </svg>
          <span data-i18n="projects.githubCta">{c.projects.githubCta}</span>
        </a>
        <a
          class="btn btn-ghost"
          href={SITE.portfolio}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"></path>
          </svg>
          <span data-i18n="projects.portfolioCta">{c.projects.portfolioCta}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== Parcours ===================== -->
  <section id="journey" class="section" aria-labelledby="journey-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="journey.kicker">{c.journey.kicker}</p>
        <h2 class="section-title" id="journey-title" data-i18n="journey.title">
          {c.journey.title}
        </h2>
      </div>

      <ol class="tl">
        {
          c.journey.items.map((item, i) => (
            <li class="tl-item reveal" data-delay={String(i % 3)}>
              <span class="tl-node" aria-hidden="true"></span>
              <div class="tl-body">
                <p class="tl-period" data-i18n={`journey.items.${i}.period`}>
                  {item.period}
                </p>
                <h3 class="tl-title" data-i18n={`journey.items.${i}.title`}>
                  {item.title}
                </h3>
                <p class="tl-subtitle" data-i18n={`journey.items.${i}.subtitle`}>
                  {item.subtitle}
                </p>
                <p class="tl-desc" data-i18n={`journey.items.${i}.description`}>
                  {item.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== Motivation ===================== -->
  <section id="motivation" class="section" aria-labelledby="motivation-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="motivation.kicker">{c.motivation.kicker}</p>
        <h2 class="section-title" id="motivation-title" data-i18n="motivation.title">
          {c.motivation.title}
        </h2>
      </div>

      <div class="motivation-grid">
        <div class="motivation-card is-wide reveal">
          <h3>
            <span class="num" aria-hidden="true">01</span>
            <span data-i18n="motivation.understood.title"
              >{c.motivation.understood.title}</span
            >
          </h3>
          <ul class="check-list">
            {
              c.motivation.understood.items.map((item, i) => (
                <li data-i18n={`motivation.understood.items.${i}`}>{item}</li>
              ))
            }
          </ul>
        </div>

        <div class="motivation-card is-wide reveal">
          <h3>
            <span class="num" aria-hidden="true">02</span>
            <span data-i18n="motivation.why.title">{c.motivation.why.title}</span>
          </h3>
          {
            c.motivation.why.paragraphs.map((paragraph, i) => (
              <p data-i18n={`motivation.why.paragraphs.${i}`}>{paragraph}</p>
            ))
          }
        </div>

        <div class="motivation-card reveal">
          <h3>
            <span class="num" aria-hidden="true">03</span>
            <span data-i18n="motivation.bring.title">{c.motivation.bring.title}</span>
          </h3>
          <ul class="check-list">
            {
              c.motivation.bring.items.map((item, i) => (
                <li data-i18n={`motivation.bring.items.${i}`}>{item}</li>
              ))
            }
          </ul>
        </div>

        <div class="motivation-card reveal" data-delay="1">
          <h3>
            <span class="num" aria-hidden="true">04</span>
            <span data-i18n="motivation.learn.title">{c.motivation.learn.title}</span>
          </h3>
          <ul class="check-list">
            {
              c.motivation.learn.items.map((item, i) => (
                <li data-i18n={`motivation.learn.items.${i}`}>{item}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Démarche IA ===================== -->
  <section id="ai" class="section" aria-labelledby="ai-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="ai.kicker">{c.ai.kicker}</p>
        <h2 class="section-title" id="ai-title" data-i18n="ai.title">{c.ai.title}</h2>
        <p class="section-intro" data-i18n="ai.intro">{c.ai.intro}</p>
      </div>

      <div class="ai-grid">
        <div class="ai-card is-wide reveal">
          <h3 data-i18n="ai.toolsTitle">{c.ai.toolsTitle}</h3>
          <ul class="tool-grid">
            {
              c.ai.tools.map((tool, i) => (
                <li class="tool">
                  <span class="tool-name" data-i18n={`ai.tools.${i}.name`}>
                    {tool.name}
                  </span>
                  <span class="tool-role" data-i18n={`ai.tools.${i}.role`}>
                    {tool.role}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ai-card is-wide reveal">
          <h3 data-i18n="ai.vibecodingTitle">{c.ai.vibecodingTitle}</h3>
          <div class="vibe-grid">
            {
              c.ai.vibecoding.map((item, i) => (
                <div class="vibe-card">
                  <p class="vibe-label" data-i18n={`ai.vibecoding.${i}.label`}>
                    {item.label}
                  </p>
                  <p class="vibe-text" data-i18n={`ai.vibecoding.${i}.text`}>
                    {item.text}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="ai-card is-wide reveal">
          <h3 data-i18n="ai.usageTitle">{c.ai.usageTitle}</h3>
          <ol class="steps-list">
            {
              c.ai.steps.map((step, i) => (
                <li class="step-item">
                  <span class="step-num" aria-hidden="true"></span>
                  <div>
                    <span class="step-name" data-i18n={`ai.steps.${i}.step`}>
                      {step.step}
                    </span>
                    <span class="step-detail" data-i18n={`ai.steps.${i}.detail`}>
                      {step.detail}
                    </span>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Workflow IA ===================== -->
  <section id="workflow" class="section" aria-labelledby="workflow-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="kicker" data-i18n="workflow.kicker">{c.workflow.kicker}</p>
        <h2 class="section-title" id="workflow-title" data-i18n="workflow.title">
          {c.workflow.title}
        </h2>
        <p class="section-intro" data-i18n="workflow.intro">{c.workflow.intro}</p>
      </div>

      <div class="wf" data-wf>
        <div class="wf-logos" data-wf-logos aria-hidden="true">
          {
            toolLogos.map((logo) => (
              <span
                class="logo"
                style={`left:${logo.left}%; top:${logo.top}%; --rot:${logo.rot}deg; --size:${logo.size}px; --delay:${logo.delay}s`}
              >
                <span class="logo-chip">
                  <img
                    src={`https://img.logo.dev/${logo.domain}?token=${SITE.logoDevToken}&size=128&format=png`}
                    alt=""
                    width="128"
                    height="128"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </span>
              </span>
            ))
          }
        </div>

        <span class="wf-track" aria-hidden="true"></span>
        <span class="wf-progress" aria-hidden="true"></span>

        <ol class="wf-steps">
          {
            c.workflow.stages.map((stage, i) => (
              <li class="wf-step" data-wf-step={i}>
                <span class="wf-node" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="wf-body">
                  <h3 class="wf-name" data-i18n={`workflow.stages.${i}.name`}>
                    {stage.name}
                  </h3>
                  <ul class="wf-items">
                    {stage.items.map((item, j) => (
                      <li data-i18n={`workflow.stages.${i}.items.${j}`}>{item}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== Contact ===================== -->
  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-card reveal">
        <p class="kicker" style="justify-content:center" data-i18n="contact.kicker">
          {c.contact.kicker}
        </p>
        <h2 class="contact-title" id="contact-title" data-i18n="contact.title">
          {c.contact.title}
        </h2>
        <p class="contact-lead" data-i18n="contact.lead">{c.contact.lead}</p>

        <div class="contact-links">
          <a class="contact-link" href={`mailto:${SITE.email}`}>
