---
import { content, SITE } from "../content";
import "../styles/global.css";

const fr = content.fr;
const year = new Date().getFullYear();

const navItems = [
  { id: "about", key: "nav.about", label: fr.nav.about },
  { id: "skills", key: "nav.skills", label: fr.nav.skills },
  { id: "projects", key: "nav.projects", label: fr.nav.projects },
  { id: "journey", key: "nav.journey", label: fr.nav.journey },
  { id: "motivation", key: "nav.motivation", label: fr.nav.motivation },
  { id: "ai", key: "nav.ai", label: fr.nav.ai },
  { id: "workflow", key: "nav.workflow", label: fr.nav.workflow },
  { id: "contact", key: "nav.contact", label: fr.nav.contact },
];
---

<!doctype html>
<html lang="fr" data-lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fr.meta.title}</title>
    <meta name="description" content={fr.meta.description} />
    <link rel="canonical" href={Astro.site} />
    <meta name="author" content="Tom Testu" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fr.meta.title} />
    <meta property="og:description" content={fr.meta.description} />
    <meta property="og:url" content={Astro.site} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#131316" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fefffc" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />

    <!-- Applique le thème et la langue avant le premier rendu, pour éviter tout flash. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (!theme) {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          }
          document.documentElement.dataset.theme = theme;

          var lang = localStorage.getItem("lang") || "fr";
          if (lang !== "en") lang = "fr";
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
        } catch (e) {}
      })();
    </script>
  </head>

  <body id="top">
    <a class="skip-link" href="#main" data-i18n="ui.skipToContent">{fr.ui.skipToContent}</a>

    <header class="site-header is-over-hero" data-header>
      <div class="nav-wrap">
        <div class="nav-pill">
          <a class="brand" href="#top" aria-label="Tom Testu, accueil">
            <span class="brand-mark" aria-hidden="true">TT</span>
            <span class="brand-name">Tom Testu</span>
          </a>

          <nav class="main-nav" id="primary-nav" data-nav aria-label={fr.ui.primaryNav}>
            <ul class="nav-list">
              {
                navItems.map((item) => (
                  <li>
                    <a class="nav-link" href={`#${item.id}`} data-i18n={item.key}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="header-actions">
            <button
              class="icon-btn lang-btn"
              type="button"
              data-lang-toggle
              data-i18n-attr="aria-label:ui.langToggle"
              aria-label={fr.ui.langToggle}
            >
              {fr.ui.langShort}
            </button>

            <button
              class="icon-btn theme-toggle"
              type="button"
              data-theme-toggle
              data-i18n-attr="aria-label:ui.themeDark"
              aria-label={fr.ui.themeDark}
            >
              <svg
                class="icon-sun"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                ></path>
              </svg>
              <svg
                class="icon-moon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
              </svg>
            </button>

            <button
              class="icon-btn menu-btn"
              type="button"
              data-menu-toggle
              aria-expanded="false"
              aria-controls="primary-nav"
              data-i18n-attr="aria-label:nav.menuOpen"
              aria-label={fr.nav.menuOpen}
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M3 6h18M3 12h18M3 18h18"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="footer">
      <div class="footer-aurora" aria-hidden="true">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="blob blob-3"></span>
      </div>

      <div class="container footer-content">
        <p class="footer-eyebrow" data-i18n="footer.eyebrow">{fr.footer.eyebrow}</p>
        <p class="footer-wordmark" data-i18n="footer.wordmark">{fr.footer.wordmark}</p>

        <div class="footer-actions">
          <a class="btn footer-btn-primary" href="#contact" data-i18n="nav.contact">
            {fr.nav.contact}
          </a>
        </div>
      </div>

      <div class="container footer-bar">
        <p class="footer-copy">
          © {year} Tom Testu · <span data-i18n="footer.rights">{fr.footer.rights}</span>
        </p>
        <nav class="footer-links">
          <a href="#top" data-i18n="footer.home">{fr.footer.home}</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={SITE.portfolio} target="_blank" rel="noopener noreferrer">Portfolio</a>
          <a href="/robots.txt">robots.txt</a>
          <a href="#top" data-i18n="ui.backToTop">{fr.ui.backToTop}</a>
        </nav>
      </div>

      <p class="container footer-built" data-i18n="footer.built">{fr.footer.built}</p>
    </footer>

    <script>
      import { content } from "../content";

      const root = document.documentElement;

      function get(obj: unknown, path: string): unknown {
        return path
          .split(".")
          .reduce<unknown>(
            (acc, key) => (acc == null ? acc : (acc as Record<string, unknown>)[key]),
            obj,
          );
      }

      function currentLang(): "fr" | "en" {
        return root.dataset.lang === "en" ? "en" : "fr";
      }

      function dict() {
        return content[currentLang()];
      }

      function syncThemeAria() {
        const btn = document.querySelector<HTMLElement>("[data-theme-toggle]");
        if (!btn) return;
        const t = dict().ui;
        btn.setAttribute(
          "aria-label",
          root.dataset.theme === "dark" ? t.themeLight : t.themeDark,
        );
      }

      function syncMenuAria() {
        const menu = document.querySelector<HTMLElement>("[data-menu-toggle]");
        const nav = document.querySelector<HTMLElement>("[data-nav]");
        if (!menu || !nav) return;
        const open = nav.classList.contains("is-open");
        menu.setAttribute("aria-label", open ? dict().nav.menuClose : dict().nav.menuOpen);
      }

      function applyLang(lang: "fr" | "en") {
        const d = content[lang];
        root.dataset.lang = lang;
        root.lang = d.meta.htmlLang;
        document.title = d.meta.title;
        document
          .querySelector('meta[name="description"]')
          ?.setAttribute("content", d.meta.description);

        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const value = get(d, el.dataset.i18n || "");
          if (typeof value === "string") el.textContent = value;
        });

        document.querySelectorAll<HTMLElement>("[data-i18n-attr]").forEach((el) => {
          (el.dataset.i18nAttr || "").split(";").forEach((pair) => {
            const [attr, key] = pair.split(":").map((s) => s.trim());
            const value = get(d, key);
            if (typeof value === "string") el.setAttribute(attr, value);
          });
        });

        const langBtn = document.querySelector<HTMLElement>("[data-lang-toggle]");
        if (langBtn) langBtn.textContent = d.ui.langShort;

        const nav = document.querySelector<HTMLElement>("[data-nav]");
        if (nav) nav.setAttribute("aria-label", d.ui.primaryNav);

        syncThemeAria();
        syncMenuAria();
        localStorage.setItem("lang", lang);
      }

      function applyTheme(theme: string) {
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        syncThemeAria();
      }

      // Sélecteurs
      document
        .querySelector<HTMLElement>("[data-theme-toggle]")
        ?.addEventListener("click", () => {
          applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
        });

      document
        .querySelector<HTMLElement>("[data-lang-toggle]")
        ?.addEventListener("click", () => {
          applyLang(currentLang() === "fr" ? "en" : "fr");
        });

      const menuBtn = document.querySelector<HTMLElement>("[data-menu-toggle]");
      const navEl = document.querySelector<HTMLElement>("[data-nav]");
      menuBtn?.addEventListener("click", () => {
        if (!navEl) return;
        const open = navEl.classList.toggle("is-open");
        menuBtn.setAttribute("aria-expanded", String(open));
        syncMenuAria();
      });

      navEl?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          navEl.classList.remove("is-open");
          menuBtn?.setAttribute("aria-expanded", "false");
          syncMenuAria();
        });
      });

      // En-tête : pilule « verre » au-dessus de l'illustration, fond opaque ensuite
      const header = document.querySelector<HTMLElement>("[data-header]");
      const heroEl = document.querySelector<HTMLElement>(".hero");
      const onScroll = () => {
        const threshold = heroEl ? heroEl.offsetHeight - 96 : 520;
        header?.classList.toggle("is-over-hero", window.scrollY < threshold);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);

      // Apparition des sections
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        revealItems.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        revealItems.forEach((el) => io.observe(el));
      }

      // Lien de navigation actif
      const links = new Map<string, HTMLElement>();
      document.querySelectorAll<HTMLAnchorElement>("[data-nav] a").forEach((a) => {
        const id = a.getAttribute("href")?.slice(1);
        if (id) links.set(id, a);
      });
      if ("IntersectionObserver" in window) {
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              links.forEach((l) => l.classList.remove("is-active"));
              links.get(entry.target.id)?.classList.add("is-active");
            });
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );
        document.querySelectorAll("section[id]").forEach((s) => spy.observe(s));
      }

      // Cartes du Profil : déplaçables, avec retour élastique à leur place
      document.querySelectorAll<HTMLElement>("[data-drag]").forEach((card) => {
        let active = false;
        let startX = 0;
        let startY = 0;
        let x = 0;
        let y = 0;

        card.addEventListener("pointerdown", (event: PointerEvent) => {
          if (event.pointerType === "mouse" && event.button !== 0) return;
          active = true;
          startX = event.clientX - x;
          startY = event.clientY - y;
          card.setPointerCapture(event.pointerId);
          card.classList.add("is-dragging");
        });

        card.addEventListener("pointermove", (event: PointerEvent) => {
          if (!active) return;
          x = event.clientX - startX;
          y = event.clientY - startY;
          const tilt = Math.max(-10, Math.min(10, x * 0.05));
          card.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${tilt}deg)`;
        });

        const release = (event: PointerEvent) => {
          if (!active) return;
          active = false;
          x = 0;
          y = 0;
          if (card.hasPointerCapture(event.pointerId)) {
            card.releasePointerCapture(event.pointerId);
          }
          card.classList.remove("is-dragging");
          card.style.transform = "";
        };

        card.addEventListener("pointerup", release);
        card.addEventListener("pointercancel", release);
      });

      // Icônes de compétences : repli (initiale) si le logo ne charge pas
      document
        .querySelectorAll<HTMLImageElement>(".skill-ico img")
        .forEach((img) => {
          const chip = img.closest<HTMLElement>(".skill-ico");
          if (!chip) return;
          const fallback = () => chip.classList.add("has-fallback");
          if (img.complete && img.naturalWidth === 0) fallback();
          img.addEventListener("error", fallback);
        });

      // Terminal : easter egg interactif (tape une commande puis Entrée)
      const termForm = document.querySelector<HTMLFormElement>("[data-terminal-form]");
      const termInput = document.querySelector<HTMLInputElement>("[data-terminal-input]");
      const termBody = document.querySelector<HTMLElement>(".terminal-body");
      if (termForm && termInput && termBody) {
        const reduceTerm = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const scrollTerm = () => {
          termBody.scrollTop = termBody.scrollHeight;
        };

        const pushLine = (kind: "cmd" | "out", text: string, accent = false) => {
          const line = document.createElement("div");
          line.className = "terminal-line is-new";
          if (kind === "cmd") {
            const prompt = document.createElement("span");
            prompt.className = "prompt";
            prompt.setAttribute("aria-hidden", "true");
            prompt.textContent = "$";
            line.append(prompt);
            const cmd = document.createElement("span");
            cmd.className = "cmd";
            cmd.textContent = ` ${text}`;
            line.append(cmd);
          } else {
            const out = document.createElement("span");
            out.className = accent ? "out is-accent" : "out";
            line.append(out);
          }
          termBody.insertBefore(line, termForm);
          scrollTerm();
          return line;
        };

        const typeOut = (line: HTMLElement, text: string) => {
          const out = line.querySelector<HTMLElement>(".out");
          if (!out) return;
          if (reduceTerm) {
            out.textContent = text;
            scrollTerm();
            return;
          }
          let i = 0;
          const timer = window.setInterval(() => {
            out.textContent = text.slice(0, ++i);
            scrollTerm();
            if (i >= text.length) window.clearInterval(timer);
          }, 26);
        };

        const respond = (raw: string) => {
          const cmd = raw.trim().toLowerCase();
          const r = dict().hero.terminal.responses;
          if (cmd === "clear" || cmd === "cls") {
            termBody
              .querySelectorAll<HTMLElement>(".terminal-line.is-new")
              .forEach((el) => el.remove());
            scrollTerm();
            return;
          }
          let text: string = r.unknown;
          let accent = true;
          if (cmd.startsWith("help") || cmd.startsWith("aide")) {
            text = r.help;
            accent = false;
          } else if (cmd.includes("stage") || cmd.includes("internship")) {
            text = r.stage;
          } else if (cmd.includes("whoami")) {
            text = r.whoami;
            accent = false;
          } else if (cmd.includes("contact") || cmd.includes("mail")) {
            text = r.contact;
            accent = false;
          }
          typeOut(pushLine("out", "", accent), text);
        };

        termForm.addEventListener("submit", (event) => {
          event.preventDefault();
          const value = termInput.value.trim();
          termInput.value = "";
          if (!value) return;
          pushLine("cmd", value);
          window.setTimeout(() => respond(value), 240);
        });

        termBody.addEventListener("click", (event) => {
          if (event.target !== termInput) termInput.focus();
        });
      }

      // Workflow : révélation au scroll + ligne de progression + apparition des logos
      const wf = document.querySelector<HTMLElement>("[data-wf]");
      if (wf) {
        const steps = Array.from(
          wf.querySelectorAll<HTMLElement>("[data-wf-step]"),
        );
        const logos = wf.querySelector<HTMLElement>("[data-wf-logos]");

        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0.25 },
          );
          steps.forEach((step) => io.observe(step));
          if (logos) io.observe(logos);
        } else {
          steps.forEach((step) => step.classList.add("is-visible"));
          logos?.classList.add("is-visible");
        }

        // La ligne se remplit selon la position de lecture
        let ticking = false;
        const updateWf = () => {
          ticking = false;
          const rect = wf.getBoundingClientRect();
          const reading = window.innerHeight * 0.55;
          const raw = rect.height ? (reading - rect.top) / rect.height : 0;
          wf.style.setProperty("--wf-p", String(Math.min(1, Math.max(0, raw))));
        };
        const onWfScroll = () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(updateWf);
        };
        updateWf();
        window.addEventListener("scroll", onWfScroll, { passive: true });
        window.addEventListener("resize", onWfScroll);
      }

      // Initialisation avec la langue courante
      applyLang(currentLang());
      syncThemeAria();
    </script>
  </body>
</html>
